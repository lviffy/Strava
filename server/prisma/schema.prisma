generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  passwordHash    String
  firstName       String
  lastName        String
  avatarUrl       String?
  city            String?
  bio             String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  activities      Activity[]
  kudos           Kudos[]
  comments        Comment[]
  following       Follow[]        @relation("UserFollows")
  followers       Follow[]        @relation("UserFollowedBy")
  segmentEfforts  SegmentEffort[]

  @@map("users")
}

model Activity {
  id                  String          @id // Client-generated UUID (idempotency key from mobile SQLite)
  userId              String
  name                String
  sportType           String          @default("Run")
  visibility          String          @default("everyone")
  startTime           DateTime
  elapsedTimeSeconds  Int
  movingTimeSeconds   Int
  distanceMeters      Float
  elevationGainMeters Float           @default(0)
  calories            Int             @default(0)
  polylineEncoded     String?         @db.Text
  startLatitude       Float?
  startLongitude      Float?
  endLatitude         Float?
  endLongitude        Float?
  deviceInfo          String?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  user                User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  coordinates         Coordinate[]
  splits              Split[]
  kudos               Kudos[]
  comments            Comment[]
  segmentEfforts      SegmentEffort[]

  @@index([userId, startTime(sort: Desc)])
  @@map("activities")
}

model Coordinate {
  id          BigInt   @id @default(autoincrement())
  activityId  String
  seq         Int
  latitude    Float
  longitude   Float
  altitude    Float?
  accuracy    Float?
  speed       Float?
  timestamp   DateTime

  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([activityId, seq])
  @@map("coordinates")
}

model Split {
  id                  Int      @id @default(autoincrement())
  activityId          String
  splitNumber         Int
  distanceUnit        String   @default("km")
  movingTimeSeconds   Int
  elevationDeltaMeters Float   @default(0)

  activity            Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@unique([activityId, splitNumber])
  @@map("splits")
}

model Kudos {
  id          String   @id @default(uuid())
  activityId  String
  userId      String
  createdAt   DateTime @default(now())

  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([activityId, userId])
  @@map("kudos")
}

model Comment {
  id          String   @id @default(uuid())
  activityId  String
  userId      String
  content     String
  createdAt   DateTime @default(now())

  activity    Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([activityId, createdAt])
  @@map("comments")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower    User     @relation("UserFollows", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowedBy", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@map("follows")
}

model Segment {
  id                  String          @id @default(uuid())
  name                String
  sportType           String          @default("Run")
  distanceMeters      Float
  elevationGainMeters Float           @default(0)
  startLatitude       Float
  startLongitude      Float
  endLatitude         Float
  endLongitude        Float
  polylineEncoded     String?         @db.Text
  createdAt           DateTime        @default(now())

  efforts             SegmentEffort[]

  @@map("segments")
}

model SegmentEffort {
  id                 String   @id @default(uuid())
  segmentId          String
  activityId         String
  userId             String
  elapsedTimeSeconds Int
  movingTimeSeconds  Int
  startDate          DateTime
  rank               Int?

  segment            Segment  @relation(fields: [segmentId], references: [id], onDelete: Cascade)
  activity           Activity @relation(fields: [activityId], references: [id], onDelete: Cascade)
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([segmentId, movingTimeSeconds(sort: Asc)])
  @@map("segment_efforts")
}
